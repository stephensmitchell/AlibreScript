# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class

# Python build and package artifacts
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Test, coverage, and analysis caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Virtual environments
.venv/
venv/
env/
ENV/

# Local environment files
.env
.env.*

# Editor and IDE noise
.vs/
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# Logs and generated local run output
*.log
*.tmp
*.bak

# OS files
Thumbs.db
Desktop.ini
.DS_Store
